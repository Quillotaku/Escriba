    <!-- Battery -->
    <string name="battery_intro">MagicOS closes background apps to save battery. If it closes Escriba, the audio waits on the watch until you open the app again.</string>
    <string name="battery_step1">1. Android battery optimization</string>
    <string name="battery_step1_exempt">Escriba is already exempt.</string>
    <string name="battery_step1_optimized">Escriba is optimized: the system may close it.</string>
    <string name="battery_exempt">Exempt</string>
    <string name="battery_exempt_action">Exempt Escriba</string>
    <string name="battery_step2">2. MagicOS app launch</string>
    <string name="battery_step2_body">Settings → Battery → App launch → Escriba: turn off \"Manage automatically\" and turn on auto-launch, secondary launch (the watch uses it to wake Escriba) and run in background.</string>
    <string name="battery_open_settings">Open Escriba\'s settings</string>
    <string name="battery_step3">3. On the watch</string>
    <string name="battery_step3_body">In the watch app, Phone section, tap \"No battery optimization\" and accept.</string>
    <string name="battery_step4">4. Check</string>
    <string name="battery_step4_body">Close Escriba on the phone (swipe it away in recents) and tap \"Test connection\" in the watch\'s Diagnostics: it should reply.</string>

